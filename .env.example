# Copy to .env. Every value here is a sample for the local mock, nothing is real.

# The HR source the kit reads.
HR_SOURCE=bamboohr

# Mock BambooHR (npm run mock)
BAMBOOHR_BASE_URL=http://localhost:4010
BAMBOOHR_COMPANY=halden
BAMBOOHR_API_KEY=sat-bamboo-key-123

# The finance source. Set to sage to activate the Sage connector.
FINANCE_SOURCE=sage

# Sage Configuration:
# --------------------
# OPTION A (Mock Mode - zero-friction offline testing):
# Run `npm run mock:sage` in another terminal, then set:
SAGE_BASE_URL=http://localhost:4020
SAGE_OAUTH_URL=http://localhost:4020/oauth/token
SAGE_CLIENT_ID=mock-client-id
SAGE_CLIENT_SECRET=mock-client-secret
SAGE_BUSINESS_ID=biz-uk-001

# OPTION B (Live Sage UK Trial):
# Set up a developer app at developerselfservice.sageone.com and uncomment below:
# SAGE_BASE_URL=https://api.accounting.sage.com/v3.1
# SAGE_OAUTH_URL=https://oauth.accounting.sage.com/token
# SAGE_CLIENT_ID=your-client-id
# SAGE_CLIENT_SECRET=your-client-secret
# SAGE_BUSINESS_ID=your-business-id

SAGE_CALLBACK_URL=http://localhost:3000/api/sage/callback

# The scheduler (npm run cron) syncs every SYNC_INTERVAL_SECONDS.
CRON_SECRET=sat-cron-secret
SYNC_INTERVAL_SECONDS=300
